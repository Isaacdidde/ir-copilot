# Copy to .env and adjust as needed. All values here override backend/config.py defaults.

# --- LLM Provider ---
# "ollama" (local, default) or "groq" (hosted, free tier, no local GPU/CPU strain)
IRCOPILOT_LLM_PROVIDER=groq

# --- Ollama-specific (used when IRCOPILOT_LLM_PROVIDER=ollama) ---
IRCOPILOT_OLLAMA_BASE_URL=http://localhost:11434
IRCOPILOT_LLM_MODEL=llama3.1:8b
IRCOPILOT_LLM_CONTEXT_WINDOW=8192

# --- Groq-specific (used when IRCOPILOT_LLM_PROVIDER=groq) ---
# Get a free API key at https://console.groq.com/keys
IRCOPILOT_GROQ_API_KEY=*****
IRCOPILOT_GROQ_MODEL=openai/gpt-oss-20b

# --- Shared generation params ---
IRCOPILOT_LLM_TEMPERATURE=0.1
IRCOPILOT_LLM_MAX_TOKENS=4000
IRCOPILOT_LLM_TIMEOUT_SECONDS=240

# --- Embeddings ---
IRCOPILOT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
IRCOPILOT_EMBEDDING_FALLBACK_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Reranker ---
IRCOPILOT_RERANKER_MODEL=BAAI/bge-reranker-base

# --- Retrieval tuning ---
# NOTE: 0.35 is tuned for the FULL knowledge base (MITRE+Sigma+NIST, ~4600+ chunks).
# If you're running only the small bundled sample knowledge base, 0.55 may be more
# appropriate. This is the single most common source of "insufficient evidence on
# every prompt" — always check this value first if results look too conservative.
IRCOPILOT_FINAL_TOP_K=5
IRCOPILOT_MIN_CONFIDENCE_THRESHOLD=0.35

# --- App ---
IRCOPILOT_API_HOST=0.0.0.0
IRCOPILOT_API_PORT=8000
IRCOPILOT_LOG_LEVEL=INFO

# --- Frontend (read directly by frontend/app.py, not via IRCOPILOT_ prefix) ---
IRCOPILOT_API_URL=http://localhost:8000



